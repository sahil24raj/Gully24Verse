6:["$","section",null,{"id":"data-collected","className":"flex flex-col gap-3 scroll-mt-28","children":[["$","h2",null,{"className":"font-['Russo_One',sans-serif] text-xl text-white uppercase tracking-wide","children":"2. Information We Collect"}],["$","p",null,{"children":"In keeping with our commitment to privacy by design, GullyVerse strictly collects only the minimal data necessary to deliver instant browser gameplay and multiplayer leaderboards:"}],["$","div",null,{"className":"space-y-3 my-2","children":[["$","div",null,{"className":"p-3.5 rounded-xl bg-black/40 border border-white/5","children":[["$","h4",null,{"className":"text-amber-400 font-bold text-xs uppercase mb-1","children":"A. Guest Session Data"}],["$","p",null,{"className":"text-xs text-slate-300","children":["For users playing without creating an account, we generate a pseudonymous device identifier (e.g. ",["$","code",null,{"children":"usr_guest_xxxx"}],") stored locally in your browser's ",["$","code",null,{"children":"localStorage"}]," to maintain your unlocked skins, game scores, and audio preferences. No email, telephone number, or real identity is collected for guest play."]}]]}],["$","div",null,{"className":"p-3.5 rounded-xl bg-black/40 border border-white/5","children":[["$","h4",null,{"className":"text-cyan-400 font-bold text-xs uppercase mb-1","children":"B. Authenticated Profile Data"}],["$","p",null,{"className":"text-xs text-slate-300","children":"When you voluntarily sign in via Google Authentication or email signup, we receive your name, email address, profile picture URL, and a unique Firebase user ID (UID)."}]]}],["$","div",null,{"className":"p-3.5 rounded-xl bg-black/40 border border-white/5","children":[["$","h4",null,{"className":"text-emerald-400 font-bold text-xs uppercase mb-1","children":"C. Gameplay & Social Telemetry"}],["$","p",null,{"className":"text-xs text-slate-300","children":"High scores, session counts, achievements, friend links in “Your Squad”, and public leaderboard standing."}]]}],["$","div",null,{"className":"p-3.5 rounded-xl bg-black/40 border border-white/5","children":[["$","h4",null,{"className":"text-purple-400 font-bold text-xs uppercase mb-1","children":"D. Technical & Diagnostic Logs"}],["$","p",null,{"className":"text-xs text-slate-300","children":"IP addresses, browser user-agent, operating system, and performance metrics collected via server logs to prevent DDoS attacks, mitigate botting, and ensure WebGL stability."}]]}]]}]]}]
