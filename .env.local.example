# Firebase Configuration for MemeVerse / GullyVerse
# Replace these placeholder values with your Firebase Project credentials from Firebase Console:
# Project Settings -> General -> Your apps -> Web app -> Config

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Cryptographic Game Session Secret (Server-Only, minimum 32 chars)
GAME_SESSION_SECRET=generate_strong_64_char_random_hex_secret_here

# Cloudflare Turnstile Bot Protection (Optional / Free Plan)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Cloudflare R2 Public Asset Storage CDN URL (Optional / Free Plan)
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_URL=https://assets.gullyverse.com
